{
  "id": "lifecycle.model.v1",
  "version": "1.0",
  "kind": "state-machine",
  "base_manifest": "contracts/protocol/transport/v1/schema/manifest.json",
  "states": [
    "ABSENT",
    "PRESENT",
    "ONLINE",
    "QUIESCING",
    "DRAINING",
    "RESETTING",
    "LOST"
  ],
  "request_identity": [
    "request_id",
    "source",
    "operation",
    "logical_device_uuid",
    "expected_generation",
    "expected_epoch",
    "daemon_incarnation_id",
    "deadline"
  ],
  "transitions": [
    {
      "event": "add",
      "sources": ["ABSENT"],
      "intermediate": ["PRESENT"],
      "terminals": ["ONLINE", "LOST", "ABSENT"],
      "generation_action": "reserve_candidate",
      "epoch_action": "unchanged",
      "commit": "install_candidate_without_retirement",
      "replay": "recorded_outcome",
      "failure_points": ["pre_commit", "post_commit"],
      "guards": [
        "state == ABSENT",
        "request identity matches authority",
        "generation and identity high-water reservation fits",
        "deadline is live"
      ],
      "owner": "metafluxd.lifecycle.Coordinator",
      "commit_points": ["candidate_reservation", "candidate_installation"],
      "high_water": {
        "generation": "reserve_and_persist",
        "identity_record": "reserve_and_persist",
        "epoch": "unchanged"
      },
      "deadline": {
        "terminal_states": ["ONLINE", "LOST", "ABSENT"],
        "timeout_error": "MF_SHARED_TIMEOUT",
        "physical_cancellation": false
      },
      "terminal_errors": [
        "MF_SHARED_SUCCESS",
        "MF_SHARED_DEVICE_LOST",
        "MF_SHARED_INVALID_ARGUMENT",
        "MF_SHARED_OVERFLOW",
        "MF_SHARED_RESOURCE_EXHAUSTED",
        "MF_SHARED_TIMEOUT"
      ]
    },
    {
      "event": "remove",
      "sources": ["ONLINE", "LOST"],
      "intermediate": ["QUIESCING", "DRAINING"],
      "terminals": ["ABSENT"],
      "generation_action": "none",
      "epoch_action": "increment_at_retirement",
      "commit": "retire_current",
      "replay": "recorded_outcome",
      "failure_points": ["pre_commit", "post_commit"],
      "guards": [
        "state == ONLINE or LOST",
        "request identity matches authority",
        "epoch increment and tombstone reservation fit",
        "deadline is live"
      ],
      "owner": "metafluxd.lifecycle.Coordinator",
      "commit_points": ["retirement_epoch_increment"],
      "high_water": {
        "generation": "unchanged_until_tombstone",
        "identity_record": "unchanged_until_tombstone",
        "epoch": "reserve_and_increment_at_retirement"
      },
      "deadline": {
        "terminal_states": ["ABSENT"],
        "timeout_error": "MF_SHARED_TIMEOUT",
        "physical_cancellation": false
      },
      "terminal_errors": [
        "MF_SHARED_SUCCESS",
        "MF_SHARED_DEVICE_LOST",
        "MF_SHARED_INVALID_ARGUMENT",
        "MF_SHARED_OVERFLOW",
        "MF_SHARED_RESOURCE_EXHAUSTED",
        "MF_SHARED_TIMEOUT"
      ]
    },
    {
      "event": "reset",
      "sources": ["ONLINE"],
      "intermediate": ["QUIESCING", "DRAINING", "RESETTING"],
      "terminals": ["ONLINE", "LOST"],
      "generation_action": "reserve_candidate",
      "epoch_action": "increment_at_retirement",
      "commit": "retire_current_and_install_candidate_atomically",
      "replay": "recorded_outcome",
      "failure_points": ["pre_commit", "post_commit"],
      "guards": [
        "state == ONLINE",
        "request identity matches authority",
        "generation, identity, and epoch reservations fit",
        "deadline is live"
      ],
      "owner": "metafluxd.lifecycle.Coordinator",
      "commit_points": [
        "candidate_reservation",
        "retirement_epoch_increment",
        "candidate_installation"
      ],
      "high_water": {
        "generation": "reserve_and_persist",
        "identity_record": "reserve_and_persist",
        "epoch": "reserve_and_increment_at_retirement"
      },
      "deadline": {
        "terminal_states": ["ONLINE", "LOST"],
        "timeout_error": "MF_SHARED_TIMEOUT",
        "physical_cancellation": false
      },
      "terminal_errors": [
        "MF_SHARED_SUCCESS",
        "MF_SHARED_DEVICE_LOST",
        "MF_SHARED_INVALID_ARGUMENT",
        "MF_SHARED_OVERFLOW",
        "MF_SHARED_RESOURCE_EXHAUSTED",
        "MF_SHARED_TIMEOUT"
      ]
    },
    {
      "event": "transport_loss",
      "sources": ["PRESENT", "ONLINE", "QUIESCING", "DRAINING", "RESETTING"],
      "intermediate": [],
      "terminals": ["LOST"],
      "generation_action": "none",
      "epoch_action": "unchanged",
      "commit": "publish_lost_tombstone",
      "replay": "recorded_outcome",
      "failure_points": [],
      "guards": [
        "state is a live lifecycle state",
        "request identity matches authority"
      ],
      "owner": "metafluxd.lifecycle.Coordinator",
      "commit_points": ["provider_view_publication"],
      "high_water": {
        "generation": "unchanged",
        "identity_record": "unchanged",
        "epoch": "unchanged"
      },
      "deadline": {
        "terminal_states": ["LOST"],
        "timeout_error": "MF_SHARED_TIMEOUT",
        "physical_cancellation": false
      },
      "terminal_errors": [
        "MF_SHARED_SUCCESS",
        "MF_SHARED_DEVICE_LOST",
        "MF_SHARED_INVALID_ARGUMENT",
        "MF_SHARED_TIMEOUT"
      ]
    },
    {
      "event": "recover",
      "sources": ["LOST"],
      "intermediate": ["RESETTING"],
      "terminals": ["ONLINE", "LOST"],
      "generation_action": "reserve_candidate",
      "epoch_action": "increment_at_retirement",
      "commit": "retire_lost_and_install_candidate_atomically",
      "replay": "recorded_outcome",
      "failure_points": ["pre_commit", "post_commit"],
      "guards": [
        "state == LOST",
        "request identity matches authority",
        "generation, identity, and epoch reservations fit",
        "deadline is live"
      ],
      "owner": "metafluxd.lifecycle.Coordinator",
      "commit_points": [
        "candidate_reservation",
        "retirement_epoch_increment",
        "candidate_installation"
      ],
      "high_water": {
        "generation": "reserve_and_persist",
        "identity_record": "reserve_and_persist",
        "epoch": "reserve_and_increment_at_retirement"
      },
      "deadline": {
        "terminal_states": ["ONLINE", "LOST"],
        "timeout_error": "MF_SHARED_TIMEOUT",
        "physical_cancellation": false
      },
      "terminal_errors": [
        "MF_SHARED_SUCCESS",
        "MF_SHARED_DEVICE_LOST",
        "MF_SHARED_INVALID_ARGUMENT",
        "MF_SHARED_OVERFLOW",
        "MF_SHARED_RESOURCE_EXHAUSTED",
        "MF_SHARED_TIMEOUT"
      ]
    }
  ],
  "request_contract": {
    "identity": [
      "request_id",
      "source",
      "operation",
      "logical_device_uuid",
      "expected_generation",
      "expected_epoch",
      "daemon_incarnation_id",
      "deadline"
    ],
    "daemon_incarnation": {
      "bits": 128,
      "reusable": false
    },
    "duplicate": "recorded_outcome_without_side_effect",
    "conflict": "reject_without_side_effect",
    "stale": "reject_without_side_effect",
    "late_completion": "generation_tombstone_returns_DEVICE_LOST"
  },
  "lease_contract": {
    "states": ["FREE", "STAGED", "REVOKED", "DRAINED", "TOMBSTONED"],
    "stage_before_identity_commit": true,
    "revoke_before_retirement": true,
    "worker_death": "publish_LOST_and_tombstone",
    "stale_completion": "reject_by_generation_and_epoch"
  },
  "deadline_policy": {
    "public_terminal_states": ["ONLINE", "LOST", "ABSENT"],
    "physical_cancellation": false,
    "timeout_error": "MF_SHARED_TIMEOUT"
  },
  "provider_views": {
    "registry_view_id": "shared_per_process",
    "cuda": {
      "initialized_membership": "frozen",
      "loss": "update_existing_entry",
      "addition": "blocked_until_new_process_or_reinit"
    },
    "nvml": {
      "initialized_membership": "frozen",
      "loss": "update_existing_entry",
      "addition": "visible_after_zero_to_one_init_epoch"
    },
    "matching": "UUID_and_generation"
  },
  "publication_model": {
    "fence_states": ["ONLINE", "LOST"],
    "telemetry_states": ["READY", "WRITING", "REJECTED"],
    "loss_wins_over_telemetry": true,
    "stale_online_forbidden": true,
    "reader": {
      "requires_even_telemetry_latch": true,
      "final_fence_recheck": true,
      "bounded_retry": true
    }
  },
  "view_gate_model": {
    "view_states": ["Open", "Closing", "Terminal", "Quarantined"],
    "device_states": ["Open", "Updating", "Closed"],
    "owner_states": ["Live", "Dead"],
    "attempt_states": ["Idle", "Entering", "Claiming", "Initializing", "Ready", "Exited"],
    "lease_states": ["Free", "Initializing", "Reserved", "Committing", "Committed", "Published", "Released", "Revoked", "Tombstoned", "Quarantined"],
    "update_states": ["Free", "Initializing", "Prepared", "Linking", "Active", "FencePublished", "Reopened", "Aborted", "Closed", "Terminal", "Quarantined"],
    "publish_states": ["Free", "Initializing", "Prepared", "Linking", "Active", "Published", "Aborted", "Terminal", "Quarantined"],
    "range_states": ["Free", "Initializing", "Prepared", "Open", "Retired", "Terminal", "Quarantined"],
    "attempt_transitions": [
      {"event": "enter_attempt", "from": "Idle", "to": "Entering"},
      {"event": "claim_lease", "from": "Entering", "to": "Claiming"},
      {"event": "materialize_lease", "from": "Claiming", "to": "Initializing"},
      {"event": "reserve_lease", "from": "Initializing", "to": "Ready"},
      {"event": "exit_attempt", "from": "Ready", "to": "Exited"}
    ],
    "lease_transitions": [
      {"event": "claim_lease", "from": "Free", "to": "Initializing"},
      {"event": "materialize_lease", "from": "Initializing", "to": "Reserved"},
      {"event": "begin_lease_commit", "from": "Reserved", "to": "Committing"},
      {"event": "finish_lease_commit", "from": "Committing", "to": "Committed"},
      {"event": "publish_lease", "from": "Committed", "to": "Published"},
      {"event": "release_lease", "from": "Published", "to": "Released"},
      {"event": "recover_dead_lease", "from": ["Reserved", "Committing", "Committed", "Published"], "to": "Tombstoned"},
      {"event": "expire_live_lease", "from": ["Reserved", "Committing", "Committed", "Published"], "to": "Revoked"},
      {"event": "reclaim_lease", "from": ["Released", "Revoked", "Tombstoned"], "to": "Free"}
    ],
    "update_transitions": [
      {"event": "claim_device_update", "from": "Free", "to": "Initializing"},
      {"event": "prepare_device_update", "from": "Initializing", "to": "Prepared"},
      {"event": "link_device_update", "from": "Prepared", "to": "Linking"},
      {"event": "complete_device_update_link", "from": "Linking", "to": "Active"},
      {"event": "publish_device_update", "from": "Active", "to": "FencePublished"},
      {"event": "reopen_device_update", "from": "FencePublished", "to": "Reopened"},
      {"event": "finish_device_update", "from": ["Active", "FencePublished", "Reopened"], "to": "Closed"},
      {"event": "recover_dead_device_update", "from": ["Initializing", "Prepared", "Linking", "Active", "FencePublished"], "to": "Aborted"},
      {"event": "expire_live_device_update", "from": ["Initializing", "Prepared", "Linking", "Active", "FencePublished"], "to": "Aborted"}
    ],
    "publish_transitions": [
      {"event": "claim_publication", "from": "Free", "to": "Initializing"},
      {"event": "prepare_publication", "from": "Initializing", "to": "Prepared"},
      {"event": "link_publication", "from": "Prepared", "to": "Linking"},
      {"event": "activate_publication", "from": "Linking", "to": "Active"},
      {"event": "apply_publication", "from": "Active", "to": "Active"},
      {"event": "mark_publication", "from": "Active", "to": "Published"},
      {"event": "finish_publication", "from": "Published", "to": "Terminal"},
      {"event": "abort_publication", "from": ["Initializing", "Prepared", "Linking", "Active"], "to": "Aborted"},
      {"event": "recover_dead_publication", "from": ["Initializing", "Prepared", "Linking", "Active", "Published"], "to": "Quarantined"},
      {"event": "expire_live_publication", "from": ["Initializing", "Prepared", "Linking", "Active", "Published"], "to": "Quarantined"}
    ],
    "range_transitions": [
      {"event": "claim_range", "from": "Free", "to": "Initializing"},
      {"event": "prepare_range", "from": "Initializing", "to": "Prepared"},
      {"event": "open_range", "from": "Prepared", "to": "Open"},
      {"event": "retire_range", "from": "Open", "to": "Retired"},
      {"event": "close_range", "from": "Retired", "to": "Terminal"}
    ],
    "view_transitions": [
      {"event": "close_view", "from": "Open", "to": "Closing"},
      {"event": "settle_view", "from": "Closing", "to": "Terminal"},
      {"event": "quarantine_view", "from": ["Open", "Closing"], "to": "Quarantined"}
    ],
    "device_transitions": [
      {"event": "claim_device_update", "from": "Open", "to": "Updating"},
      {"event": "finish_device_update", "from": "Updating", "to": "Open"},
      {"event": "close_device", "from": ["Open", "Updating"], "to": "Closed"}
    ],
    "invariants": [
      "no_live_lease_after_terminal_view",
      "device_updating_tuple_matches",
      "intermediate_visible_implies_payload_applied",
      "publication_range_matches_when_active",
      "only_lowest_unclosed_range_publishes",
      "no_mutable_token_position_separate_from_cursor",
      "blocked_loss_closes_admission",
      "settled_close_retains_reserved_pairs",
      "live_writer_quarantine",
      "policy_reopens_after_old_leases_resolve",
      "updater_death_does_not_strand_updating",
      "stale_cas_cannot_defeat_loss",
      "telemetry_never_wraps_or_mixed_bank",
      "stable_reader_never_tears",
      "invalidated_actor_never_publishes",
      "closed_mirror_rolls_back_never"
    ]
  },
  "side_effects": [
    "reserve_generation_candidate",
    "persist_generation_high_water",
    "stage_transport_and_worker_lease",
    "publish_intermediate_state",
    "drain_old_generation",
    "retire_generation_and_advance_epoch",
    "install_candidate",
    "publish_provider_loss_or_addition",
    "retain_generation_tombstone"
  ],
  "commit_points": [
    "candidate_reservation",
    "retirement_epoch_increment",
    "candidate_installation",
    "provider_view_publication"
  ],
  "terminal_errors": [
    "MF_SHARED_SUCCESS",
    "MF_SHARED_DEVICE_LOST",
    "MF_SHARED_INVALID_ARGUMENT",
    "MF_SHARED_OVERFLOW",
    "MF_SHARED_RESOURCE_EXHAUSTED",
    "MF_SHARED_TIMEOUT"
  ],
  "invariants": [
    "single_live_generation_owner",
    "generation_candidates_never_reused",
    "epoch_changes_only_at_retirement",
    "retirement_epoch_increment_is_exactly_one",
    "duplicate_requests_are_idempotent",
    "current_generation_is_not_retired",
    "old_generation_tombstones_are_isolated",
    "transport_loss_preserves_generation_and_epoch",
    "cuda_membership_freezes_after_initialization",
    "nvml_addition_waits_for_reinitialization",
    "provider_loss_updates_existing_entries",
    "daemon_incarnation_is_not_device_generation",
    "terminal_state_is_complete"
  ]
}
