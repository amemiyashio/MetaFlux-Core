#!/usr/bin/env bash
# Validate the exact staged MetaFlux tree before an agent commit.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if git diff --cached --quiet; then
  exit 0
fi

run_without_git_local_environment() (
  local variable

  while IFS= read -r variable; do
    if [[ -n "$variable" ]]; then
      unset "$variable"
    fi
  done < <(git rev-parse --local-env-vars)

  "$@"
)

candidate_root="$(
  run_without_git_local_environment nix develop . --command mktemp -d
)"
cleanup_candidate_root() {
  run_without_git_local_environment \
    nix develop . --command rm -rf -- "$candidate_root"
}
trap cleanup_candidate_root EXIT

git checkout-index --all --prefix="$candidate_root/"

run_without_git_local_environment nix develop . --command python3 \
  "$candidate_root/tools/check-agent-state.py" \
  "$candidate_root" \
  --commit-gate
run_without_git_local_environment nix develop . --command python3 \
  "$candidate_root/tools/test-check-agent-state.py"
run_without_git_local_environment nix develop . --command python3 -B \
  "$candidate_root/tools/check-skill-routing.py" \
  "$candidate_root"
run_without_git_local_environment nix develop . --command python3 -B \
  "$candidate_root/tools/test-check-skill-routing.py"
run_without_git_local_environment nix develop . --command python3 -B \
  "$candidate_root/agent/skills/detect-agent-tool/scripts/test_detect_agent_tool.py"
run_without_git_local_environment nix develop . --command python3 -B \
  "$candidate_root/agent/skills/start-work/scripts/test_commit_as_agent_tool.py"

git diff --cached --check
