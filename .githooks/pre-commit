#!/usr/bin/env bash
# Validate the exact staged MetaFlux tree before an agent commit.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

diagnostic_format="${METAFLUX_DIAGNOSTIC_FORMAT:-human}"
case "$diagnostic_format" in
  human|json) ;;
  *) diagnostic_format=human ;;
esac

run_without_git_local_environment() (
  local variable

  while IFS= read -r variable; do
    if [[ -n "$variable" ]]; then
      unset "$variable"
    fi
  done < <(git rev-parse --local-env-vars)

  "$@"
)

check_commit_input() {
  run_without_git_local_environment nix develop . --command python3 -B \
    agent/skills/main/scripts/commit_as_agent_tool.py \
    --check-commit-gate --diagnostic-format "$diagnostic_format"
}
check_commit_input

if git diff --cached --quiet; then
  exit 0
fi

candidate_root="$(
  run_without_git_local_environment nix develop . --command mktemp -d
)"
cleanup_candidate_root() {
  run_without_git_local_environment \
    nix develop . --command rm -rf -- "$candidate_root"
}
trap cleanup_candidate_root EXIT

git checkout-index --all --prefix="$candidate_root/"

run_without_git_local_environment nix develop . --command python3 \
  "$candidate_root/tools/check-agent-state.py" \
  "$candidate_root" \
  --commit-gate \
  --diagnostic-format "$diagnostic_format"
run_without_git_local_environment nix develop . --command python3 \
  "$candidate_root/tests/architecture/test-check-agent-state.py"
run_without_git_local_environment nix develop . --command python3 -B \
  "$candidate_root/tests/architecture/test-agent-diagnostics.py"
run_without_git_local_environment nix develop . --command python3 -B \
  "$candidate_root/tools/check-skill-routing.py" \
  "$candidate_root" \
  --diagnostic-format "$diagnostic_format"
run_without_git_local_environment nix develop . --command python3 -B \
  "$candidate_root/tests/architecture/test-check-skill-routing.py"
run_without_git_local_environment nix develop . --command python3 -B \
  "$candidate_root/agent/skills/main/scripts/test_detect_agent_tool.py"
run_without_git_local_environment nix develop . --command python3 -B \
  "$candidate_root/agent/skills/main/scripts/test_commit_as_agent_tool.py"
run_without_git_local_environment nix develop . --command python3 -B \
  "$candidate_root/agent/skills/main/scripts/test_commit_gate.py"
run_without_git_local_environment nix develop . --command python3 -B \
  "$candidate_root/agent/skills/main/scripts/test_push_repository.py"

git diff --cached --check
for controller_test in main/scripts/test_workflow_state.py main/scripts/test_rule_loading.py main/scripts/test_tool_gate.py batch/scripts/test_batch.py epoch/scripts/test_check_route_proposal.py; do
  run_without_git_local_environment nix develop . --command python3 -B "$candidate_root/agent/skills/$controller_test"
done
check_commit_input
