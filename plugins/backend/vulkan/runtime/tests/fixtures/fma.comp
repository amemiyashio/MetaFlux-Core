#version 450

// FP32 FMA throughput kernel for the GPU probe: every invocation drives CHAINS
// independent accumulator chains so per-lane FMA latency is hidden by ILP, and
// the stored value is the exact dyadic sum of all chain results, verifiable
// bit-for-bit against the scalar reference.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) restrict writeonly buffer Dst {
    float dst[];
};

layout(std430, set = 0, binding = 1) restrict readonly buffer Src {
    float src[];
};

layout(push_constant) uniform Push {
    uint count;
    uint rounds;
} push_constants;

const uint CHAINS = 16U;

void main() {
    const uint index = gl_GlobalInvocationID.x;
    if (index >= push_constants.count) {
        return;
    }
    const float x0 = src[index];
    float chains[CHAINS];
    for (uint c = 0U; c < CHAINS; ++c) {
        chains[c] = x0 + float(c);
    }
    for (uint round = 0U; round < push_constants.rounds; ++round) {
        for (uint c = 0U; c < CHAINS; ++c) {
            chains[c] = fma(chains[c], 0.5, x0);
        }
    }
    float sum = 0.0;
    for (uint c = 0U; c < CHAINS; ++c) {
        sum += chains[c];
    }
    dst[index] = sum;
}
