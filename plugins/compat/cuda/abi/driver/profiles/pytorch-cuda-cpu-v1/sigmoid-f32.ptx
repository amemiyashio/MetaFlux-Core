.version 9.0
.target sm_70
.address_size 64
.extern .func  (.param .f32) expf (.param .f32);
.visible .entry sigmoid_f32(
  .param .u64 destination,
  .param .u64 input,
  .param .f32 zero,
  .param .f32 one,
  .param .u32 count
)
{
  .reg .pred %p;
  .reg .b32 %r<10>;
  .reg .f32 %f<10>;
  .reg .b64 %rd<10>;
  ld.param.u64 %rd0, [destination];
  ld.param.u64 %rd1, [input];
  ld.param.f32 %f0, [zero];
  ld.param.f32 %f1, [one];
  ld.param.u32 %r0, [count];
  mov.u32 %r1, %tid.x;
  mov.u32 %r2, %ctaid.x;
  mov.u32 %r3, %ntid.x;
  mad.lo.u32 %r4, %r2, %r3, %r1;
  setp.ge.u32 %p, %r4, %r0;
  @%p bra done;
  mul.wide.u32 %rd3, %r4, 4;
  add.u64 %rd4, %rd0, %rd3;
  add.u64 %rd5, %rd1, %rd3;
  ld.global.f32 %f2, [%rd5];
  sub.rn.f32 %f3, %f0, %f2;
  call (%f4), expf, (%f3);
  add.rn.f32 %f5, %f1, %f4;
  div.rn.f32 %f6, %f1, %f5;
  st.global.f32 [%rd4], %f6;
done:
  ret;
}
