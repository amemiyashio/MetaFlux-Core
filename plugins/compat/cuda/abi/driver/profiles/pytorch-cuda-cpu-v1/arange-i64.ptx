.version 9.0
.target sm_70
.address_size 64
.visible .entry arange_i64(
  .param .u64 destination,
  .param .u32 unused0,
  .param .u32 unused1,
  .param .u32 count,
  .param .u32 start_low,
  .param .u32 start_high,
  .param .u32 step_low,
  .param .u32 step_high
)
{
  .reg .pred %p<4>;
  .reg .b32 %r<9>;
  .reg .b64 %rd<6>;
  ld.param.u64 %rd0, [destination];
  ld.param.u32 %r0, [count];
  mov.u32 %r1, %tid.x;
  mov.u32 %r2, %ctaid.x;
  mov.u32 %r3, %ntid.x;
  mad.lo.u32 %r4, %r2, %r3, %r1;
  mov.u32 %r5, 0;
  mov.u32 %r6, 1;
  setp.ge.u32 %p1, %r4, %r0;
  @%p1 bra done;
  setp.gt.s32 %p2, %r5, %r4;
  sub.u32 %r7, %r5, %r6;
  selp.b32 %r8, %r7, %r5, %p2;
  mul.wide.u32 %rd2, %r4, 8;
  add.u64 %rd3, %rd0, %rd2;
  st.global.u32 [%rd3], %r4;
  mul.wide.u32 %rd4, %r6, 4;
  add.u64 %rd5, %rd3, %rd4;
  st.global.u32 [%rd5], %r8;
done:
  ret;
}
