  ld.global.f32 %f26, [%rd16];
  mul.rn.f32 %f27, %f24, %f0;
  fma.rn.f32 %f28, %f25, %f1, %f27;
  fma.rn.f32 %f29, %f26, %f2, %f28;
  st.global.f32 [%rd26], %f29;
  mul.rn.f32 %f30, %f24, %f3;
  fma.rn.f32 %f31, %f25, %f4, %f30;
  fma.rn.f32 %f32, %f26, %f5, %f31;
  st.global.f32 [%rd29], %f32;

  ld.global.f32 %f33, [%rd10];
  ld.global.f32 %f34, [%rd17];
  ld.global.f32 %f35, [%rd18];
  mul.rn.f32 %f36, %f33, %f0;
