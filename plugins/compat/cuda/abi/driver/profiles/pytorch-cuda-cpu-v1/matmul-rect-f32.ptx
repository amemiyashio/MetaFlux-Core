  ld.global.f32 %f8, [%rd12];
  mul.rn.f32 %f9, %f6, %f0;
  fma.rn.f32 %f10, %f7, %f1, %f9;
  fma.rn.f32 %f11, %f8, %f2, %f10;
  st.global.f32 [%rd0], %f11;
  mul.rn.f32 %f12, %f6, %f3;
  fma.rn.f32 %f13, %f7, %f4, %f12;
  fma.rn.f32 %f14, %f8, %f5, %f13;
