.version 9.0
.target sm_70
.address_size 64
.visible .entry clamp_min_f32(
  .param .u64 destination,
  .param .u64 input,
  .param .f32 lower,
  .param .u32 count
)
{
  .reg .pred %p<3>;
  .reg .b32 %r<10>;
  .reg .f32 %f<3>;
  .reg .b64 %rd<10>;
  ld.param.u64 %rd0, [destination];
  ld.param.u64 %rd1, [input];
  ld.param.f32 %f2, [lower];
  ld.param.u32 %r0, [count];
  mov.u32 %r1, %tid.x;
  mov.u32 %r2, %ctaid.x;
  mov.u32 %r3, %ntid.x;
  mad.lo.u32 %r4, %r2, %r3, %r1;
  setp.ge.u32 %p1, %r4, %r0;
  @%p1 bra done;
  mul.wide.u32 %rd2, %r4, 4;
  add.u64 %rd3, %rd0, %rd2;
  add.u64 %rd4, %rd1, %rd2;
  ld.global.f32 %f1, [%rd4];
  ld.global.u32 %r5, [%rd4];
  setp.lt.f32 %p2, %f1, %f2;
  st.global.f32 [%rd3], %f2;
  @!%p2 st.global.u32 [%rd3], %r5;
done:
  ret;
}
