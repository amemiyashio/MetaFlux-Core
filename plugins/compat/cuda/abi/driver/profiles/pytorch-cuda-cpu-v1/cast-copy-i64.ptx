.version 9.0
.target sm_70
.address_size 64
.visible .entry cast_copy_i64(
  .param .u64 destination,
  .param .u64 source,
  .param .u32 unused,
  .param .u32 count
)
{
  .reg .pred %p<4>;
  .reg .b32 %r<10>;
  .reg .b64 %rd<8>;
  ld.param.u64 %rd0, [destination];
  ld.param.u64 %rd1, [source];
  ld.param.u32 %r0, [count];
  mov.u32 %r1, %tid.x;
  mov.u32 %r2, %ctaid.x;
  mov.u32 %r3, %ntid.x;
  mad.lo.u32 %r4, %r2, %r3, %r1;
  mov.u32 %r5, 0;
  mov.u32 %r6, 1;
  setp.ge.u32 %p1, %r4, %r0;
  @%p1 bra done;
  mul.wide.u32 %rd2, %r4, 4;
  add.u64 %rd3, %rd1, %rd2;
  ld.global.u32 %r7, [%rd3];
  setp.gt.s32 %p2, %r5, %r7;
  sub.u32 %r8, %r5, %r6;
  selp.b32 %r9, %r8, %r5, %p2;
  mul.wide.u32 %rd4, %r4, 8;
  add.u64 %rd5, %rd0, %rd4;
  st.global.u32 [%rd5], %r7;
  mul.wide.u32 %rd6, %r6, 4;
  add.u64 %rd7, %rd5, %rd6;
  st.global.u32 [%rd7], %r9;
done:
  ret;
}
