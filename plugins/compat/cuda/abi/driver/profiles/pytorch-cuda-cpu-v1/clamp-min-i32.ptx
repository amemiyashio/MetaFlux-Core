.version 9.0
.target sm_70
.address_size 64
.visible .entry clamp_min_i32(
  .param .u64 destination,
  .param .u64 input,
  .param .u32 unused,
  .param .u32 count,
  .param .u32 floor
)
{
  .reg .pred %p<3>;
  .reg .b32 %r<12>;
  .reg .b64 %rd<8>;
  ld.param.u64 %rd0, [destination];
  ld.param.u64 %rd1, [input];
  ld.param.u32 %r0, [count];
  ld.param.u32 %r1, [floor];
  mov.u32 %r2, %tid.x;
  mov.u32 %r3, %ctaid.x;
  mov.u32 %r4, %ntid.x;
  mad.lo.u32 %r5, %r3, %r4, %r2;
  setp.ge.u32 %p1, %r5, %r0;
  @%p1 bra done;
  mul.wide.u32 %rd2, %r5, 4;
  add.u64 %rd3, %rd0, %rd2;
  add.u64 %rd4, %rd1, %rd2;
  ld.global.u32 %r6, [%rd4];
  setp.gt.s32 %p2, %r1, %r6;
  selp.b32 %r7, %r1, %r6, %p2;
  st.global.u32 [%rd3], %r7;
done:
  ret;
}
