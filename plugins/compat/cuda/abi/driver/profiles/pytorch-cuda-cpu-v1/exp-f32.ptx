.version 9.0
.target sm_70
.address_size 64
.extern .func  (.param .f32) expf (.param .f32);
.visible .entry exp_f32(
  .param .u64 destination,
  .param .u64 input,
  .param .u64 unused,
  .param .u32 count
)
{
  .reg .pred %p;
  .reg .b32 %r<10>;
  .reg .f32 %f<10>;
  .reg .b64 %rd<10>;
  ld.param.u64 %rd0, [destination];
  ld.param.u64 %rd1, [input];
  ld.param.u32 %r0, [count];
  mov.u32 %r1, %tid.x;
  mov.u32 %r2, %ctaid.x;
  mov.u32 %r3, %ntid.x;
  mad.lo.u32 %r4, %r2, %r3, %r1;
  setp.ge.u32 %p, %r4, %r0;
  @%p bra done;
  mul.wide.u32 %rd3, %r4, 4;
  add.u64 %rd4, %rd0, %rd3;
  add.u64 %rd5, %rd1, %rd3;
  ld.global.f32 %f1, [%rd5];
  call (%f2), expf, (%f1);
  st.global.f32 [%rd4], %f2;
done:
  ret;
}
