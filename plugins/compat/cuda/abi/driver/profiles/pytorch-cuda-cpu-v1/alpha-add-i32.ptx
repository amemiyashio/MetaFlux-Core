.version 9.0
.target sm_70
.address_size 64
.visible .entry alphaadd_i32(
  .param .u64 destination,
  .param .u64 left,
  .param .u64 right,
  .param .u32 count,
  .param .u32 alpha
)
{
  .reg .pred %p;
  .reg .b32 %r<10>;
  .reg .b64 %rd<10>;
  ld.param.u64 %rd0, [destination];
  ld.param.u64 %rd1, [left];
  ld.param.u64 %rd2, [right];
  ld.param.u32 %r0, [count];
  ld.param.u32 %r1, [alpha];
  mov.u32 %r2, %tid.x;
  mov.u32 %r3, %ctaid.x;
  mov.u32 %r4, %ntid.x;
  mad.lo.u32 %r5, %r3, %r4, %r2;
  setp.ge.u32 %p, %r5, %r0;
  @%p bra done;
  mul.wide.u32 %rd3, %r5, 4;
  add.u64 %rd4, %rd0, %rd3;
  add.u64 %rd5, %rd1, %rd3;
  add.u64 %rd6, %rd2, %rd3;
  ld.global.u32 %r6, [%rd5];
  ld.global.u32 %r7, [%rd6];
  mad.lo.u32 %r8, %r1, %r7, %r6;
  st.global.u32 [%rd4], %r8;
done:
  ret;
}
