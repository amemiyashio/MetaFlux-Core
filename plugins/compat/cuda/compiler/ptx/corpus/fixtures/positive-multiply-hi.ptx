.version 9.0
.target sm_70
.address_size 64
.entry multiply_hi(
  .param .u64 out_hi,
  .param .u32 a,
  .param .u32 b
)
{
  .reg .b32 %r<4>;
  .reg .b64 %rd<2>;
  ld.param.u64 %rd0, [out_hi];
  ld.param.u32 %r0, [a];
  ld.param.u32 %r1, [b];
  mul.hi.u32 %r2, %r0, %r1;
  st.global.u32 [%rd0], %r2;
  ret;
}
