.version 9.0
.target sm_70
.address_size 64
.entry special_2d(.param .u64 output)
{
  .reg .b32 %r<20>;
  .reg .b64 %rd<4>;
  ld.param.u64 %rd0, [output];
  mov.u32 %r0, %tid.x;
  mov.u32 %r1, %tid.y;
  mov.u32 %r2, %ntid.x;
  mov.u32 %r3, %ntid.y;
  mov.u32 %r4, %ctaid.x;
  mov.u32 %r5, %ctaid.y;
  mov.u32 %r6, %nctaid.x;
  mov.u32 %r7, %nctaid.y;
  mad.lo.u32 %r8, %r5, %r6, %r4;
  mad.lo.u32 %r9, %r1, %r2, %r0;
  mul.lo.u32 %r10, %r2, %r3;
  mad.lo.u32 %r11, %r8, %r10, %r9;
  mul.wide.u32 %rd1, %r11, 4;
  add.u64 %rd2, %rd0, %rd1;
  st.global.u32 [%rd2], %r11;
  ret;
}
