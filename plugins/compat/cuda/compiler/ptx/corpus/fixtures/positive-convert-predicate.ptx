.version 9.0
.target sm_70
.address_size 64
.entry convert_predicate(
  .param .u64 out_float,
  .param .u64 out_integer,
  .param .u64 out_guard,
  .param .u32 integer_value,
  .param .f32 float_value,
  .param .f32 float_limit
)
{
  .reg .pred %p0;
  .reg .pred %p1;
  .reg .pred %p2;
  .reg .b32 %r<4>;
  .reg .b64 %rd<3>;
  .reg .f32 %f<4>;
  ld.param.u64 %rd0, [out_float];
  ld.param.u64 %rd1, [out_integer];
  ld.param.u64 %rd2, [out_guard];
  ld.param.u32 %r0, [integer_value];
  ld.param.f32 %f0, [float_value];
  ld.param.f32 %f1, [float_limit];
  cvt.rn.f32.u32 %f2, %r0;
  cvt.rzi.u32.f32 %r1, %f0;
  setp.ge.u32 %p0, %r1, %r0;
  setp.eq.u32 %p1, %r1, %r1;
  setp.lt.f32 %p2, %f0, %f1;
  st.global.f32 [%rd0], %f2;
  st.global.u32 [%rd1], %r1;
  @%p1 st.global.u32 [%rd2], %r1;
  @!%p2 st.global.u32 [%rd2], %r0;
  ret;
}
