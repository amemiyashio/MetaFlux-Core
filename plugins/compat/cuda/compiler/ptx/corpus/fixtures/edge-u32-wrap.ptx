.version 9.0
.target sm_70
.address_size 64
.entry wrap(.param .u64 output, .param .u32 a, .param .u32 b)
{
  .reg .b32 %r<6>;
  .reg .b64 %rd;
  ld.param.u64 %rd, [output];
  ld.param.u32 %r0, [a];
  ld.param.u32 %r1, [b];
  add.u32 %r2, %r0, %r1;
  sub.u32 %r3, %r1, %r0;
  mul.lo.u32 %r4, %r0, %r1;
  mad.lo.u32 %r5, %r0, %r1, %r1;
  st.global.u32 [%rd], %r2;
  ret;
}
