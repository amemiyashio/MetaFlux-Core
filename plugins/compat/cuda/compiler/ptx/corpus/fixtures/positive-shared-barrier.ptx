.version 9.0
.target sm_70
.address_size 64
.entry shared_reverse(
  .param .u64 output,
  .param .u32 last,
  .param .u32 one
)
{
  .shared .align 4 .u32 scratch[4];
  .reg .pred %p;
  .reg .b32 %r<13>;
  .reg .b64 %rd<4>;
  ld.param.u64 %rd0, [output];
  ld.param.u32 %r0, [last];
  ld.param.u32 %r1, [one];
  mov.u32 %r2, %tid.x;
  mov.u32 %r3, scratch;
  add.u32 %r4, %r1, %r1;
  add.u32 %r5, %r4, %r4;
  mul.lo.u32 %r6, %r2, %r5;
  add.u32 %r7, %r3, %r6;
  add.u32 %r8, %r2, %r1;
  setp.eq.u32 %p, %r1, %r1;
  @%p st.shared.u32 [%r7], %r8;
  bar.sync 0;
  sub.u32 %r9, %r0, %r2;
  mul.lo.u32 %r10, %r9, %r5;
  add.u32 %r11, %r3, %r10;
  ld.shared.u32 %r12, [%r11];
  mul.wide.u32 %rd1, %r2, 4;
  add.u64 %rd2, %rd0, %rd1;
  st.global.u32 [%rd2], %r12;
  ret;
}
