  mov.u32 %r16, scratch;
  mul.lo.u32 %r17, %r8, %r2;
  add.u32 %r18, %r16, %r17;
  st.shared.u32 [%r18], %r15;
  bar.sync 0;
  setp.ge.u32 %p0, %r8, %r6;
  add.u32 %r19, %r18, %r10;
  ld.shared.u32 %r20, [%r18];
  ld.shared.u32 %r21, [%r19];
  add.u32 %r22, %r20, %r21;
  @!%p0 st.shared.u32 [%r18], %r22;
  bar.sync 0;
  setp.ge.u32 %p1, %r8, %r5;
  add.u32 %r23, %r18, %r9;
  ld.shared.u32 %r24, [%r18];
  ld.shared.u32 %r25, [%r23];
  add.u32 %r26, %r24, %r25;
  @!%p1 st.shared.u32 [%r18], %r26;
  bar.sync 0;
