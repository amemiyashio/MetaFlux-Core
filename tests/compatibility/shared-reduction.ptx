  add.u32 %r30, %r28, %r29;
  @!%p2 st.shared.u32 [%r18], %r30;
  bar.sync 0;
  setp.ge.u32 %p3, %r8, %r3;
  add.u32 %r31, %r18, %r5;
  ld.shared.u32 %r32, [%r18];
  ld.shared.u32 %r33, [%r31];
  add.u32 %r34, %r32, %r33;
  @!%p3 st.shared.u32 [%r18], %r34;
  bar.sync 0;
  setp.ge.u32 %p4, %r8, %r2;
  add.u32 %r35, %r18, %r4;
  ld.shared.u32 %r36, [%r18];
  ld.shared.u32 %r37, [%r35];
  add.u32 %r38, %r36, %r37;
