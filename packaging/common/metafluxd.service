[Unit]
Description=MetaFlux local compute service
Requires=metafluxd.socket
After=metafluxd.socket

[Service]
Type=simple
ExecStart=/usr/bin/metafluxd
User=metaflux
Group=metaflux
RuntimeDirectory=metaflux
RuntimeDirectoryMode=0755
CacheDirectory=metaflux
CacheDirectoryMode=0750
StateDirectory=metaflux
StateDirectoryMode=0750
Environment=METAFLUX_SOCKET=/run/metaflux/metafluxd.sock
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
