/.clangd/
/compile_commands.json
/CMakeUserPresets.json

__pycache__/
*.py[cod]

*.profraw
*.profdata
*.gcda
*.gcno

# Workspace scratch lives under tmp/ (decision-0042). The tracked README is
# the only inhabitant; every generated subtree stays host state.
/tmp/**
!/tmp/README.md

# Obsolete workspace scratch homes. They remain ignored so leftover host
# trees cannot re-enter Git, but no workflow may write them.
/.cache/
/build/
/outputs/
/result
/.zcode/
/.metaflux-build/
/.metaflux-evidence/
/linux-*/

# Product drivers are tracked; their local Kbuild outputs are ignored inside.
!/linux-kernel-drivers/
